#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp ESC               &kp Q             &kp W       &kp E         &kp R     &kp T                                                     &kp Y                  &kp U  &kp I      &kp O       &kp P      &kp BSPC
&kp LC(TAB)           &kp A             &kp S       &kp D         &kp F     &kp G                                                     &kp H                  &kp J  &kp K      &kp L       &kp SEMI   &mt LEFT_CONTROL ENTER
&mt LEFT_SHIFT GRAVE  &kp Z             &kp X       &kp C         &kp V     &kp B                                                     &kp N                  &kp M  &kp COMMA  &kp PERIOD  &kp SLASH  &mt LEFT_SHIFT DELETE
&to 1                 &kp LEFT_CONTROL  &kp K_BACK  &kp LEFT_ALT  &kp LGUI  &lt 3 INTERNATIONAL_5  &lt 5 SPACE  &mt LEFT_SHIFT ENTER  &lt 4 INTERNATIONAL_4  &none  &none      &none       &kp N0     &mo 2
&kp RCTRL             &kp RCTRL
            >;
        };

        layer_1 {
            bindings = <
&trans            &trans            &trans        &trans  &trans            &trans                       &trans       &trans  &trans  &trans  &trans  &trans
&mt LEFT_GUI TAB  &trans            &trans        &trans  &trans            &trans                       &trans       &trans  &trans  &trans  &trans  &mt LEFT_GUI ENTER
&trans            &trans            &trans        &trans  &trans            &trans                       &trans       &trans  &trans  &trans  &trans  &trans
&trans            &kp LEFT_CONTROL  &kp CAPSLOCK  &trans  &mt LEFT_GUI TAB  &lt 3 LANG2  &trans  &trans  &lt 4 LANG1  &trans  &trans  &trans  &trans  &to 0
&trans            &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans  &trans  &mo 6   &kp C_VOLUME_UP                    &msc SCRL_LEFT  &msc SCRL_RIGHT  &trans    &trans    &trans  &trans
&trans  &trans  &trans  &none   &none   &kp K_MUTE                         &msc SCRL_UP    &mkp MB1         &mkp MB3  &mkp MB2  &mo 3   &trans
&trans  &trans  &trans  &trans  &trans  &kp C_VOLUME_DOWN                  &msc SCRL_DOWN  &mkp MB4         &none     &mkp MB5  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans             &trans  &trans  &trans          &trans           &trans    &trans    &trans  &trans
&trans  &trans
            >;
        };

        layer_3 {
            bindings = <
&trans            &kp NUMBER_1       &kp NUMBER_2   &kp N3          &kp N4      &kp N5                                &kp N6             &kp N7        &kp N8         &kp N9             &kp N0                &kp DELETE
&kp F11           &kp PSCRN          &kp F2         &kp F3          &kp F4      &kp F5                                &kp LEFT           &kp DOWN      &kp UP_ARROW   &kp RIGHT          &mt LEFT_ALT PAGE_UP  &mt LEFT_CONTROL HOME
&kp LS(F12)       &kp F6             &kp F7         &kp F8          &kp F9      &kp F10                               &kp LC(PAGE_UP)    &kp LS(LEFT)  &kp LS(RIGHT)  &kp LC(PAGE_DOWN)  &kp PAGE_DOWN         &mt LEFT_SHIFT END
&kp LG(UP_ARROW)  &kp LS(LG(RIGHT))  &kp LC(COMMA)  &kp LC(PERIOD)  &kp DELETE  &trans   &kp ENTER  &kp LS(LG(LEFT))  &kp LS(LG(RIGHT))  &trans        &kp TAB        &kp DEL            &trans                &trans
&trans            &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &kp LS(NUMBER_1)    &kp LS(NUMBER_2)  &kp LS(NUMBER_3)  &kp LS(NUMBER_4)  &kp LS(N5)                              &kp LS(NUMBER_6)  &kp LS(N7)      &kp LS(N8)            &kp LS(NUMBER_9)  &kp LS(N0)         &trans
&trans  &kp LA(LC(DELETE))  &trans            &trans            &kp LA(F4)        &kp SQT                                 &kp EQUAL         &kp MINUS       &kp NON_US_BACKSLASH  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp GRAVE
&trans  &kp LA(GRAVE)       &trans            &trans            &trans            &kp DOUBLE_QUOTES                       &kp PLUS          &kp UNDERSCORE  &kp PIPE              &kp LEFT_BRACE    &kp RIGHT_BRACE    &kp LS(GRAVE)
&trans  &trans              &trans            &trans            &trans            &trans             &trans  &lt 3 ENTER  &trans            &trans          &trans                &trans            &trans             &trans
&trans  &trans
            >;
        };

        layer_5 {
            bindings = <
&trans          &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &kp K_MUTE                  &kp INSERT       &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_COMMA  &trans
&bt BT_CLR_ALL  &bt BT_DISC 0  &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_DISC 3  &trans                      &kp KP_NUMLOCK   &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp COLON     &kp F2
&out OUT_USB    &trans         &trans         &trans         &trans         &trans                      &kp TAB          &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PERIOD    &kp F4
&out OUT_BLE    &trans         &trans         &trans         &trans         &trans      &trans  &trans  &kp KP_NUMBER_0  &trans           &trans           &trans           &trans        &trans
&trans          &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans    &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &mo 3   &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &mkp MB4  &none     &mkp MB5  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans  &trans
&trans  &trans
            >;
        };
    };
};
